# ---------------------------------------------------------------------------
# JobSonar credentials
#
#   cp .env.example .env.local
#
# Put real values in .env.local ONLY. Both .env and .env.local are git-ignored;
# this example file is the only one that is tracked, so no key can be committed
# by accident. .env.local is loaded last and wins over .env.
#
# Every key is optional — JobSonar runs with none of them set, using only the
# no-key scrapers and public ATS APIs. Each key just unlocks more sources.
# ---------------------------------------------------------------------------

# JSearch (RapidAPI) — aggregated board listings.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch  (free tier available)
# Leave blank to skip the source rather than burning requests on 401s.
JSEARCH_API_KEY=

# Adzuna — free developer tier, good India coverage.
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Anthropic — powers LLM job scoring plus resume-bullet and cover-letter
# tailoring. Optional but recommended; keyword scoring works without it.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OmniRoute (https://omniroute.online) — optional alternative LLM backend.
# Only needed if you set llm.provider: omniroute in config/search.yaml.
# Run `omniroute` locally (dashboard + API come up on localhost:20128), grab
# a dashboard key if your instance requires auth, and put it here.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
